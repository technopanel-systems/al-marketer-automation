# Secrets — never committed
.env
.env.local
.env.*.local

# Dependencies and caches
node_modules/
.npm/

# Temporary and generated scratch output
tmp/
*.log
spikes/output/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Generated sample and preview output (re-created by commands)
samples/**/out/
samples/out/

# AI fallback request/answer archives are kept; temporary render folders are not
clients/*/output/draft/previews/
clients/_archive/*/output/draft/previews/

# Deleted proposals waiting for Windows to release a locked file
clients/_trash/

# Hand-filled keys worksheet (secrets) - never committed
API-KEYS.txt

# Downloaded helper tools (yt-dlp) — re-downloaded by the launcher
tools/

# Friend package: private Node.js, built packages, setup result
runtime/
dist/
setup-report.txt
